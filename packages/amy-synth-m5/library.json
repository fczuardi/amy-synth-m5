{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "amy-synth-m5",
  "version": "0.2.0",
  "description": "AMY synth helpers and M5Stack Core Gray speaker bridge",
  "keywords": ["amy", "synth", "m5stack", "core-gray", "audio"],
  "repository": {
    "type": "git",
    "url": "https://github.com/fczuardi/amy-synth-m5.git"
  },
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": [
    "AmyRuntime.h",
    "AmyPitchBend.h",
    "AmySynthSlot.h",
    "AmyMonophonicInstrumentSink.h",
    "AmyM5SpeakerBridge.h",
    "AmyAudioActivityGate.h",
    "AmyM5MonophonicSynth.h"
  ],
  "dependencies": [
    {
      "name": "firmware-contracts",
      "version": "https://github.com/fczuardi/embedded-music-experiments.git#c62653e916bb"
    },
    {
      "owner": "fcz2",
      "name": "monophonic-instrument",
      "version": "0.1.2"
    },
    {
      "name": "AMY Synthesizer",
      "version": "https://github.com/shorepine/amy.git#1.2.108"
    },
    {
      "owner": "m5stack",
      "name": "M5Unified",
      "version": "0.2.17"
    }
  ],
  "export": {
    "include": [
      "README.md",
      "include/*",
      "src/*",
      "library.json"
    ]
  }
}
